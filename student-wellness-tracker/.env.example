# ---------------------------------------------------------------------------
# Database (PostgreSQL — e.g. Supabase, Neon, or Railway connection string)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/wellness_tracker"
# Use a separate direct (non-pooled) connection for Prisma migrations if your
# provider pools connections (Supabase/Neon do). Falls back to DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/wellness_tracker"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Supabase Storage (avatars, journal attachments)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Transactional email (verification + password reset) — Resend
